{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArabicDocumentExtraction",
  "description": "AI Evaluation Contract v1 — Page-level document extraction with Arabic preservation",
  "type": "object",
  "required": ["tender_id","source_document","page_number","language_detected","text_blocks","extraction_confidence"],
  "properties": {
    "tender_id": {"type": "string"},
    "source_document": {"type": "string"},
    "page_number": {"type": "integer"},
    "language_detected": {"type": "string", "enum": ["AR","EN","BILINGUAL"]},
    "text_blocks": {"type": "array", "items": {"type": "object", "required": ["bbox","text_ar","text_normalized"], "properties": {"bbox":{"type":"array","items":{"type":"number"},"minItems":4,"maxItems":4},"text_ar":{"type":"string","description":"Original Arabic"},"text_normalized":{"type":"string","description":"Normalized + optional translation"},"confidence":{"type":"number"}}}},
    "tables": {"type": "array", "items": {"type": "object", "properties": {"table_id":{"type":"string"},"bbox":{"type":"array","items":{"type":"number"}},"headers":{"type":"array","items":{"type":"string"}},"rows":{"type":"array","items":{"type":"array","items":{"type":"string"}}},"extraction_confidence":{"type":"number"}}}},
    "ocr_applied": {"type": "boolean"},
    "ocr_model": {"type": ["string","null"]},
    "extraction_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "checksums": {"type": "object", "properties": {"page_hash":{"type":"string"}}}
  }
}
