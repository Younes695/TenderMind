{
	email {$EMAIL}
}

{$DOMAIN} {
	encode gzip
	# large tender packages: one 2 GB file (the app's per-file cap) plus the
	# multipart envelope must fit; the app enforces its own per-file limits
	request_body {
		max_size 2100MiB
	}
	reverse_proxy app:8001 {
		transport http {
			read_timeout 10m
			write_timeout 10m
		}
	}
}
