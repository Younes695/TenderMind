# Copy to .env and fill in. .env is git-ignored — never commit real secrets.
TENDERMIND_ENV=production
# Optional bootstrap admin (users normally sign up at /signup). Set both or neither.
# Each account only sees its own tenders and company documents; the admin also
# owns data created before accounts existed. Production refuses to start with a
# weak or placeholder admin password.
# TENDERMIND_AUTH_EMAIL=admin@yourcompany.com
# TENDERMIND_AUTH_PASSWORD=
# Allow new accounts at /signup and first-time Google/Microsoft sign-in (default true)
# TENDERMIND_SIGNUP_ENABLED=true
# Generate: python3 -c 'import secrets; print(secrets.token_hex(32))'
TENDERMIND_SESSION_SECRET=
# true when served over HTTPS (recommended); false only for plain-http testing
TENDERMIND_COOKIE_SECURE=true

# Optional
# PORT=8001
# TENDERMIND_CORS_ORIGINS=https://your-frontend-domain.com
# TENDERMIND_TESSERACT_PATH=/usr/bin/tesseract
# DATABASE_URL=sqlite:////var/lib/tendermind/tender.db
# TENDERMIND_STORAGE_ROOT=/var/lib/tendermind/uploads
# Interactive API docs (/docs) are off in production; set 1 to expose them
# TENDERMIND_API_DOCS=0

# AI (optional — off by default; deterministic extraction works without it)
# TENDERMIND_TWO_STAGE_LLM=1
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b
# Parallel AI calls (measured 1.64x faster at 2 workers; >2 gives no gain on one GPU)
# TENDERMIND_WORKERS_ENABLED=1
# TENDERMIND_MAX_AI_WORKERS=2
# Prompt: minimal-2 is the default (Stage 5A); set minimal-1 only to roll back
# TENDERMIND_PROMPT_VERSION=minimal-2
# Per-task escalation: re-ask ONLY UNKNOWN/failed candidates with a second model.
# Default qwen3:4b (Stage 5G: 60/70 -> 62/70; `ollama pull qwen3:4b`). "off" disables.
# TENDERMIND_ESCALATION_MODEL=qwen3:4b
# TENDERMIND_ESCALATION_TIMEOUT=150
# Evidence judge model for Evaluate (default = OLLAMA_MODEL)
# TENDERMIND_MATCHER_MODEL=qwen2.5:3b

# Public address of the site — used to build the Google/Microsoft redirect URI:
#   <TENDERMIND_PUBLIC_URL>/api/auth/oauth/google/callback
#   <TENDERMIND_PUBLIC_URL>/api/auth/oauth/microsoft/callback
# TENDERMIND_PUBLIC_URL=https://tendermind.yourcompany.com

# Google sign-in: Google Cloud Console > APIs & Services > Credentials >
# OAuth client ID (type "Web application"); add the redirect URI above.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Microsoft sign-in: Azure Portal > Microsoft Entra ID > App registrations >
# New registration (Web platform, redirect URI above) > Certificates & secrets.
# Tenant: "common" = any work/school or personal Microsoft account.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common

# File types (Stage 5E): RAR needs unrar, 7-Zip or bsdtar on the server
# (Linux: apt-get install -y unrar  or  p7zip-full  or  libarchive-tools).
# AutoCAD DWG / .bak drawings need the free ODA File Converter:
# TENDERMIND_ODA_CONVERTER=/usr/bin/ODAFileConverter
